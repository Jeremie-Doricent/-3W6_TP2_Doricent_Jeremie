@{
}

@model Categorie

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Categorie</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Nom" class="control-label"></label>
                <input asp-for="Nom" class="form-control" />
                <span asp-validation-for="Nom" class="text-warning"></span>
            </div>
            <div class="form-group mb-3">
                <input type="submit" value="Create" class="btn btn-success w-100" />
            </div>
        </form>
    </div>
</div>
@if (TempData["Erreur"] != null)
{
    <div class="text-warning">@TempData["Erreur"]</div>
}

<div>
    <a asp-action="Index">Back to List</a>
</div>
@if (TempData["Succes"] != null)
{
    <div class="alert alert-success">@TempData["Succes"]</div>
}
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}