@using NutriVie.Models
@model IEnumerable<Categorie>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Recettes</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nom</td>
                <td>
                    @foreach (var r in item.Recettes)
                    {
                        <a asp-controller="Recette" asp-action="Details" asp-route-id="@r.Id"
                           style="text-decoration:none; color:inherit;">@($"{r.Nom} ({r.TempsPreparation} min)")</a>
                        <span> </span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>