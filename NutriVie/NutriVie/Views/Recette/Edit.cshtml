@model NutriVie.ViewModel.RecetteCate

@{
    ViewData["Title"] = "Edit";
}

<h1>Create</h1>

<h4>Recette</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="@Model.Recette.Nom" class="control-label"></label>
                <input asp-for="@Model.Recette.Nom" class="form-control" />
                <span asp-validation-for="@Model.Recette.Nom" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="@Model.Recette.Description" class="control-label"></label>
                <input asp-for="@Model.Recette.Description" class="form-control" />
                <span asp-validation-for="@Model.Recette.Description" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="@Model.Recette.TempsPreparation" class="control-label">Durée (min)</label>
                <input asp-for="@Model.Recette.TempsPreparation" class="form-control" />
                <span asp-validation-for="@Model.Recette.TempsPreparation" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="@Model.Recette.TempsCuisson" class="control-label">Cuisson (min)</label>
                <input asp-for="@Model.Recette.TempsCuisson" class="form-control" />
                <span asp-validation-for="@Model.Recette.TempsCuisson" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="@Model.Recette.Image" class="control-label"></label>
                <input asp-for="@Model.Recette.Image" class="form-control" />
                <span asp-validation-for="@Model.Recette.Image" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="@Model.Recette.CategorieId" class="control-label">Catégorie</label>
                <select asp-for="@Model.Recette.CategorieId" class="form-control form-select" asp-items="@Model.Cate"></select>
                <span asp-validation-for="@Model.Recette.CategorieId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <input type="submit" value="Create" class="btn btn-success w-100" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}